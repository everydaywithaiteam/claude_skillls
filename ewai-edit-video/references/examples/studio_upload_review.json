    {"do": "hold", "s": 2.0},
    {"do": "move", "via": [{"x": 1520, "y": 330}, {"x": 1520, "y": 619}], "via_s": 0.55,
     "to": {"text": "Private", "within": "ytcp-video-metadata-visibility", "fy": 0.6}, "s": 0.7},
