    {"do": "hold", "s": 1.6},
    {"do": "move", "to": {"selector": "#description-textarea", "fx": 0.5, "fy": 0.12}, "s": 0.9},
    {"do": "hold", "s": 1.2},
    {"do": "scroll", "to": {"text": "Thumbnail"}, "offset": 230, "s": 2.0},
    {"do": "move", "to": {"text": "Thumbnail", "fx": 0, "fy": 0, "dx": 80, "dy": 110}, "s": 0.9},
    {"do": "hold", "s": 1.8},
    {"do": "scroll", "top": true, "s": 1.5},
    {"do": "click", "to": {"text": "Languages", "within": "ytcp-navigation-drawer", "fx": 0.3}, "s": 1.0,
     "wait_for": "text=Edit subtitles", "settle_ms": 2500},
    {"do": "hold", "s": 0.6},
    {"do": "move", "to": {"text": "Video language: English", "exact": false, "fx": 0.45}, "s": 0.9},
